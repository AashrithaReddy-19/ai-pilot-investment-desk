# Copy to .env and adjust. Never commit real secrets (.env is git-ignored).
# Every variable read by the backend is listed here.

# ---------------- Go API (backend/) ----------------
# HTTP port of the public API
PORT=8080
# PostgreSQL connection (source of truth). Required.
DATABASE_URL=postgres://c23:change-me@localhost:5432/c23?sslmode=disable
# Redis cache (optional). Empty = cache disabled. Correctness never depends on Redis.
REDIS_URL=redis://localhost:6379/0
# FastAPI internal AI service (optional). Empty = AI disabled (ai_status=disabled); numbers/decisions unchanged.
AI_SERVICE_URL=http://localhost:8001
# Hard timeout for each AI call, milliseconds
AI_TIMEOUT_MS=1500
# Comma-separated exact origins allowed by CORS ("*" is deliberately not supported). Empty = no CORS headers.
CORS_ORIGINS=http://localhost:5173
# Directory with the SHA-256 verified official data (MANIFEST.json, official_fixture.json, extension.json)
RAW_DATA_DIR=../decision-engine/data/raw
# Request body limit in bytes (default 1 MiB)
MAX_BODY_BYTES=1048576
# Apply embedded SQL migrations on startup
AUTO_MIGRATE=true
# Import the official C23 fixture on startup (ignored if already present)
SEED_OFFICIAL=false
# Optional write protection: when set, POST/PUT need header X-API-Key: <value>
API_KEY=
# info | debug
LOG_LEVEL=info

# ---------------- tests ----------------
# Optional: run DB tests against an existing PostgreSQL instead of the embedded one (then use `go test -p 1 ./...`)
TEST_DATABASE_URL=

# ---------------- docker compose ----------------
POSTGRES_PASSWORD=change-me
