# Copy to .env (ignored by git). Real environment variables always win over .env.
PORT=8080
DATABASE_URL=postgres://c23:CHANGE_ME@localhost:5432/c23?sslmode=disable
# Leave REDIS_URL empty to run without cache. With a password: redis://:password@localhost:6379/0
REDIS_URL=redis://localhost:6379/0
RULES_ENGINE_URL=http://localhost:8000
# The cache key follows the rules engine's own rules_version (read from its /health every
# RULES_VERSION_POLL_SECONDS). RULES_VERSION is only a fallback until the engine has answered; leave it unset.
# RULES_VERSION=
RULES_VERSION_POLL_SECONDS=30
ALLOWED_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=5
# 0 disables the cache
CACHE_TTL_SECONDS=1800
MAX_BODY_BYTES=1048576
# true = apply pending migrations when the server starts (handy locally)
AUTO_MIGRATE=false
# release | debug
GIN_MODE=release

# ---- Security (B5) ----
# off      = no sign-in; everything runs in the default workspace (local development, test.sh, browser checks)
# required = every /api/v1 call needs "Authorization: Bearer <token>"; X-Workspace-ID picks the workspace.
#            Create the first user and token with:  go run ./cmd/api bootstrap -email you@example.com -workspace "Finance"
AUTH_MODE=off
# Requests per minute per client IP (0 disables) and the burst allowed above that rate
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=120

# ---- Stored uploads (B4) ----
# Largest stored upload in bytes (the engine parses at most 2,000,000)
UPLOAD_MAX_BYTES=2000000
# Run the upload processing worker in this process, and how often it polls for queued uploads
WORKER_ENABLED=true
WORKER_POLL_MS=1000
