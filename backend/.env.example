# Copy to .env (ignored by git). Real environment variables always win over .env.
PORT=8080
DATABASE_URL=postgres://c23:CHANGE_ME@localhost:5432/c23?sslmode=disable
# Leave REDIS_URL empty to run without cache. With a password: redis://:password@localhost:6379/0
REDIS_URL=redis://localhost:6379/0
RULES_ENGINE_URL=http://localhost:8000
# Bump this whenever the Python rules or its data files change (it is part of every cache key)
RULES_VERSION=1
ALLOWED_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=5
# 0 disables the cache
CACHE_TTL_SECONDS=1800
MAX_BODY_BYTES=1048576
# true = apply pending migrations when the server starts (handy locally)
AUTO_MIGRATE=false
# release | debug
GIN_MODE=release
