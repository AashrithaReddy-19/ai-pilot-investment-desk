# ==============================================================================
# OpenTofu Variables Configuration (Copy to tofu.tfvars)
# ==============================================================================

# AWS Region to deploy resources into
aws_region = "us-east-1"

# AWS Credentials
# (Recommended: leave commented/blank and use `aws configure` or AWS_ACCESS_KEY_ID environment variables)
# aws_access_key = "YOUR_AWS_ACCESS_KEY_ID"
# aws_secret_key = "YOUR_AWS_SECRET_ACCESS_KEY"

# EC2 Instance Type (t3.small: 2 vCPUs, 2 GB RAM)
instance_type = "t3.small"

# SSH Key Setup (Optional: paste your public key to enable SSH access as user 'ubuntu')
# public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... user@example.com"
# SSH is closed unless you list your own address here (use /32 for a single IP)
# allowed_ssh_cidr = ["203.0.113.4/32"]

# The decision engine is reached by the gateway on localhost; open it to others only if needed
# decision_engine_public_cidr = ["203.0.113.4/32"]

# Exact browser origins allowed to call the gateway cross-origin (comma-separated, no wildcards)
# allowed_origins = "https://desk.example.com"

# Gateway sign-in. "required" (default) needs a bearer token per request: after deploy, SSH in and run
#   cd /opt/c23/backend && ./bin/api bootstrap -email you@example.com -workspace "Finance"
# to create the first admin and print their token. "off" runs without sign-in (demos only).
# auth_mode = "required"
# rate_limit_per_minute = 600

# Application Database Password for role 'c23'
db_password = "c23SecurePassword123"

# Git Repository URL to deploy on the EC2 instance
repo_url = "https://github.com/AashrithaReddy-19/ai-pilot-investment-desk.git"

# Project Tagging
project_name = "c23-pilot-desk"
environment  = "production"
