# Leave empty in development: requests go to the same origin and Vite proxies /api, /health and /ready to the Go gateway.
# Set to a full URL (for example https://desk.example.com) to call a deployed gateway directly; its CORS list must include this app's origin.
VITE_API_BASE=
# Where the development proxy forwards to.
VITE_PROXY_TARGET=http://127.0.0.1:8080
